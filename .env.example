# Clave de la API de Gemini (obligatoria). Créala en https://aistudio.google.com/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# URL pública donde corre la app (enlaces y callbacks). En local: http://localhost:3000
APP_URL="MY_APP_URL"

# --- Opcionales: lectura de facturas ---
# Modelo principal y modelos de respaldo (separados por comas) si el principal falla o está saturado
# GEMINI_MODEL="gemini-3.8-flash"
# GEMINI_FALLBACK_MODELS="gemini-3-flash-preview"
# Tiempo máximo por llamada a Gemini, en milisegundos
# GEMINI_TIMEOUT_MS=90000
# Facturas leídas en paralelo por la cola en segundo plano (bájalo si tu cuota de Gemini es pequeña)
# INVOICE_WORKER_CONCURRENCY=4
# Carpeta donde se guarda el historial de la cola (por defecto .data dentro del proyecto)
# INVOICE_DATA_DIR=".data"
